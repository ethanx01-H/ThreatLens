# API Keys for IP/Domain Reputation Tool
# Set these to enable additional OSINT sources.
# Free-tier sources (IPInfo, OTX) work without keys.

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan — https://account.shodan.io/
SHODAN_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api
OTX_API_KEY=

# IPInfo — https://ipinfo.io/account/token
IPINFO_TOKEN=

# Abuse.ch (ThreatFox + URLhaus) — https://auth.abuse.ch/
# ABUSECH_API_KEY=
